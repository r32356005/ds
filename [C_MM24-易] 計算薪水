#include <stdio.h>

int main() {
    int hours, per;
    double money;
    while (scanf("%d %d", &hours, &per) == 2) {
        if (hours <= 60) {
            money = hours * per;
            printf("%.1f\n", money);
        } else if (hours > 60 && hours <= 120) {
            money = (60 * per) + ((hours - 60) * per * 1.33);
            printf("%.1f\n", money);
        } else {
            money = (60 * per) + (60 * per * 1.33) + ((hours - 120) * per * 1.66);
            printf("%.1f\n", money);
        }
    }
    return 0;
}
