#include <stdio.h>
#include <string.h>
int main() {
    int n;
    scanf("%d", &n);
    while (n--) {
        char a[1001];
        scanf("%s", a);
        int length = strlen(a);
        for (int i = length - 1; i >= 0; i--) {
            printf("%c", a[i]);
        }
        printf("\n");
    }

    return 0;
}
