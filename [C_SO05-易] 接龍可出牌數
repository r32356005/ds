#include <stdio.h>

int main() {
    int bo[52] = {};
    int n;
    scanf("%d", &n);
    int sum = 0;

    for (int i = 0; i < n; i++) {
        int num;
        scanf("%d", &num);
        bo[num] = 1;
    }

    int hand;
    scanf("%d", &hand);

    for (int i = 0; i < hand; i++) {
        int num;
        scanf("%d", &num);
        bo[num] = 2;
    }

    if (bo[6] == 2) sum += 1;
    if (bo[19] == 2) sum += 1;
    if (bo[32] == 2) sum += 1;
    if (bo[45] == 2) sum += 1;

    for (int i = 0; i < 52; i++) {
        if (bo[i] == 1) {
            if (i != 0 && i != 13 && i != 26 && i != 39 && i != 12 && i != 25 && i != 38 && i != 51) {
                if (bo[i - 1] == 2) sum++;
                if (bo[i + 1] == 2) sum++;
            }
        }
    }

    printf("%d\n", sum);
    return 0;
}
