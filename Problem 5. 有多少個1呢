#include <stdio.h>

int main() {
    int n;
    scanf("%d", &n);
    for (int i = 1; i <= n; i++) {
        int a[32] = {};
        int num, flag = 0;
        scanf("%d", &num);
        if (num < 0) {
            num = -num - 1;
            flag = 1;
        }
        int index = 0;
        while (num > 0) {
            a[index] = num % 2;
            num /= 2;
            index++;
        }
        int count = 0;
        if (flag != 1) {
            for (int j = 0; j < 32; j++) {
                if (a[j] == 1) {
                    count++;
                }
            }
        } else {
            for (int j = 0; j < 32; j++) {
                if (a[j] == 0) {
                    count++;
                }
            }
        }
        printf("%d\n", count);
    }
    return 0;
}
