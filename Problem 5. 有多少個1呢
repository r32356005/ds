#include <bits/stdc++.h>
#include <stdio.h>
using namespace std;
int main(){
  int n;
  scanf("%d",&n);
  for(int i=1;i<=n;i++){
    int a[32]={};
    int num;
    scanf("%d",&num);
    int flag=0;
    if(num<0){
      num=-num;
      num-=1;
      flag=1;
      //cout<<"true"<<endl;
    }
    int index=0;
    while(num>0){
      a[index]=num%2;
      num/=2;
      index++;
    }
    /*for(int j=0;j<32;j++){
      cout<<a[j]<<" ";
    }
    cout<<endl;*/
    int count=0;
    if(!(flag==1)){
      for(int j=0;j<32;j++){
        if(a[j]==1){
          count++;
        }
      }
    }else{
      for(int j=0;j<32;j++){
        if(a[j]==0){
          count++;
        }
      }
    }
    printf("%d\n",count);
  }
}
