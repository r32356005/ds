#include <stdio.h>

int main() {
    int a, b = 0;

    while (scanf("%d", &a) == 1) {
        int temp = 0;
        b = 0;

        while (1) {
            temp++;
            b += temp;
            if (a < b) {
                break;
            }
        }

        printf("%d\n", temp - 1);
    }

    return 0;
}
