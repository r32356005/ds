#include <stdio.h>
#include <string.h>

int main() {
    int time;
    scanf("%d", &time);

    for (int i = 0; i < time; i++) {
        char a[81];
        int cou, t = 0;
        int b[81] = {0};

        scanf("%d", &cou);
        scanf("%s", a);

        for (int j = 0; j < cou; j++) {
            if (a[j] == '.' && b[j + 1] == 0 && b[j] == 0) {
                b[j + 2] = 1;
                t++;
            }
        }

        printf("%d\n", t);
    }

    return 0;
}
