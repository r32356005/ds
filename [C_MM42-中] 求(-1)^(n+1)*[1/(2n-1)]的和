#include <stdio.h>
#include <cmath>
#include <iomanip>
using namespace std;
int main(){
  int n;
  double sum,tmp;
  while(scanf("%d", &n)){
    sum=0;
  for(int i=1;i<=n;i++){
    tmp=pow(-1,i+1)/(2*i-1);
    sum=sum+tmp;
  }
  //cout<<fixed<<setprecision(3)<<sum<<endl;
   printf("%.3f\n", sum);
}
  return 0;
}
