#include <stdio.h>

int main() {
    int num1, num2, num3, sum;
    while (scanf("%d %d", &num1, &num2) == 2) {
        if (num2 > num1) {
            num3 = num1;
            num1 = num2;
            num2 = num3;
        }
        sum = 0;
        for (int j = num2; j <= num1; j++) {
            sum = sum + j;
        }
        printf("%d\n", sum);
    }
    return 0;
}
