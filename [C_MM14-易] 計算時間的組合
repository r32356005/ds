#include <stdio.h>

int main() {
    int into, sum, sec, minute, hours, day;
    scanf("%d", &into);
    day = into / 86400;
    sum = into - day * 86400;
    hours = sum / 3600;
    sum = sum - hours * 3600;
    minute = sum / 60;
    sum = sum - minute * 60;

    printf("%d days\n", day);
    printf("%d hours\n", hours);
    printf("%d minutes\n", minute);
    printf("%d seconds\n", sum);

    return 0;
}
