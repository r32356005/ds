#include <stdio.h>

int main() {
    int r, flag;
    while (scanf("%d", &r) == 1) {
        flag = 1;
        for (int a = 2; a <= r - 1; a++) {
            if (r % a == 0) {
                flag = 0;
                break;
            }
        }
        if (flag == 0) {
            printf("NO\n");
        } else {
            printf("YES\n");
        }
    }
    return 0;
}
