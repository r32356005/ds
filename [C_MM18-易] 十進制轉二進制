#include <stdio.h>

int main() {
    int n, i;
    while (scanf("%d", &n) == 1) {
        if (n >= 0) {
            int a[8] = {0};
            for (i = 0; n > 0; i++) {
                a[i] = n % 2;
                n = n / 2;
            }
            for (i = 7; i >= 0; i--) {
                printf("%d", a[i]);
            }
            printf("\n");
        } else {
            int a[8] = {1};
            for (i = 0; n > 0; i++) {
                a[i] = n % 2;
                n = n / 2;
            }
            for (i = 7; i >= 0; i--) {
                if (a[i] == 1) {
                    a[i] = 0;
                } else if (a[i] == 0) {
                    a[i] = 1;
                }
                printf("%d", a[i]);
            }
            printf("\n");
        }
    }
    return 0;
}
