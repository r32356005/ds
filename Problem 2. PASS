#include <stdio.h>
int main(){
  int n;
scanf("%d",&n);
  for(int i=1;i<=n;i++){
    int sc1,sc2,sc3;
    scanf("%d %d %d",&sc1,&sc2,&sc3);
    int over=0;
    
    if(sc1>=60)
      over++;
    if(sc2>=60)
      over++;
    if(sc3>=60)
      over++;
    
    if(over==3){
      printf("P\n");
    }else if(over==2&&(sc1+sc2+sc3)>=220){
      printf("P\n");
    }else if(over==2&&(sc1+sc2+sc3)<220){
      printf("M\n");
    }else if(over==1&&((sc1>=80)||(sc2>=80)||(sc3>=80))){
      printf("M\n");
    }else{
      printf("F\n");
    }
  }
  return 0;
}
