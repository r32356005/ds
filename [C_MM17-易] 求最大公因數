#include <stdio.h>

int main() {
    int a, b, c;
    while (scanf("%d %d", &a, &b) == 2) {
        if (a > b) {
            int q;
            q = a;
            a = b;
            b = q;
        }
        while (b != 0) {
            c = b;
            b = a % b;
            a = c;
        }
        printf("%d\n", a);
    }
    return 0;
}
